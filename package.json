{
  "name": "@bujosa/computer-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An owned Linux desktop for any MCP agent",
  "license": "UNLICENSED",
  "bin": {
    "computer-mcp": "src/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node scripts/integration.mjs",
    "test:catalog-integration": "node scripts/catalog-integration.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/check.mjs && node scripts/build-ui.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@novnc/novnc": "https://github.com/novnc/noVNC/archive/refs/tags/v1.6.0.tar.gz",
    "esbuild": "0.25.12",
    "express": "5.1.0",
    "playwright": "1.64.0",
    "ws": "8.22.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "prettier": "3.6.2"
  }
}
