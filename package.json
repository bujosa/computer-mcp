{
  "name": "@bujosa/computer-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An owned Linux desktop for any MCP agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bujosa/computer-mcp.git"
  },
  "homepage": "https://github.com/bujosa/computer-mcp#readme",
  "bugs": {
    "url": "https://github.com/bujosa/computer-mcp/issues"
  },
  "keywords": [
    "mcp",
    "computer-use",
    "agent-skills",
    "sendtry"
  ],
  "mcpName": "io.github.bujosa/computer-mcp",
  "license": "MIT",
  "files": [
    "npm-shrinkwrap.json",
    "src/**/*.js",
    "runtime/**/*.js",
    "runtime/*.py",
    "runtime/*.sh",
    "runtime/Dockerfile",
    "ui/*.js",
    "ui/*.html",
    "ui/*.css",
    "ui/assets/*.svg",
    "skills/**/*.md",
    "skills/**/*.txt",
    "skills/**/agents/*.yaml",
    "LICENSE",
    "TRADEMARKS.md",
    "THIRD_PARTY_NOTICES.md",
    "scripts/build-ui.mjs",
    ".dockerignore",
    "docs/SETUP.md",
    "docs/PUBLICATION.md",
    "docs/RECOVERY.md",
    "docs/TEACH.md",
    "docs/TASKS.md",
    "docs/DESKTOP.md",
    "docs/ACTIVITY.md",
    "docs/ASSIGNMENTS.md",
    "docs/TOOLS-AND-SKILLS.md",
    "SECURITY.md"
  ],
  "bin": {
    "computer-mcp": "src/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "check:package": "node scripts/check-package.mjs",
    "check:skill": "node scripts/check-skill.mjs",
    "test:integration": "node scripts/integration.mjs",
    "test:catalog-integration": "node scripts/catalog-integration.mjs",
    "test:assignments-integration": "node scripts/assignments-integration.mjs",
    "test:teach-integration": "node scripts/teach-integration.mjs",
    "test:audit-integration": "node scripts/audit-integration.mjs",
    "test:desktop-integration": "node scripts/desktop-integration.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/check.mjs && node scripts/build-ui.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@novnc/novnc": "https://github.com/novnc/noVNC/archive/refs/tags/v1.6.0.tar.gz",
    "esbuild": "0.25.12",
    "express": "5.1.0",
    "playwright": "1.64.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "yaml": "2.9.1"
  }
}
